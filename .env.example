# Public, browser-safe values only (NEXT_PUBLIC_ prefix). Never put secrets here.

# Canonical site URL (no trailing slash). Optional; when unset, canonical/OG absolute URLs are omitted.
# NEXT_PUBLIC_SITE_URL=

# Base URL/path for experience assets (models, textures, hdr, audio). Optional; defaults to /experience.
# Set to an absolute URL only when assets are hosted elsewhere (document the reason in TECHNICAL_BASELINE.md).
# NEXT_PUBLIC_ASSET_BASE_URL=
